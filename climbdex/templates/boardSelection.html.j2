<!DOCTYPE html>
<html>

<head>
    {% include 'head.html.j2' %}
    <style>
        .input-group-text {
            width: 175px;
        }
    </style>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
            crossorigin="anonymous"></script>
</head>

<body>
<div class="container-sm text-center">
    {% include 'heading.html.j2' %}
    {% include 'alert.html.j2' %}
    <div class="row justify-content-md-center">
        <div class="col-md-5">
            <form class="card p-3 bg-light" action="/filter" id="form-board">
                <div class="input-group mb-3">
                    <span class="input-group-text">Board</span>
                    <select class="form-select" id="select-board" name="board">
                        <option value="decoy">Decoy</option>
                        <option value="grasshopper">
                            Grasshopper
                        </option>
                        <option value="kilter" selected>Kilter</option>
                        <option value="tension">Tension</option>
                        <option value="touchstone">
                            Touchstone
                        </option>
                    </select>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Layout</span>
                    <select class="form-select" id="select-layout" name="layout">
                    </select>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Size</span>
                    <select class="form-select" id="select-size" name="size"></select>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Reach
{#                        <span class="tooltiptext">Tooltip text</span>#}
                    </span>
                    <input type="number" class="form-control" id="input-reach" min="32" max="96"
                           value="48" step="8" name="reach"/>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Power
                        <span class="tooltiptext">Tooltip text</span>
                    </span>
                    <input type="number" class="form-control" id="input-power" value="1.0" min="1.0" max="2.2"
                           step="0.1" name="power"/>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Finger Strength
                        <span class="tooltiptext">Tooltip text</span>
                    </span>
                    <input type="number" class="form-control" id="input-finger" value="1.0" min="1.0" max="2.2"
                           step="0.1" name="fingerStrength"/>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Core Strength
                        <span class="tooltiptext">Tooltip text</span>
                    </span>
                    <input type="number" class="form-control" id="input-core" value="1.0" min="0" max="10"
                           step="0.1" name="coreStrength"/>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Grade
                        <span class="tooltiptext">Your grade in the font format, for number followed by letter, optionally +</span>
                    </span>
                    <select class="form-select" id="select-grade" name="grade">
                        {% for grade in ["4", "4+", "5", "5+", "6A", "6A+", "6B", "6B+", "6C", "6C+", "7A", "7A+", "7B", "7B+", "7C",
               "7C+", "8A", "8A+", "8B", "8B+", "8C", "8C+"] %}
                            <option value="{{ grade }}">
                                {{ grade }}
                            </option>
                        {% endfor %}
                    </select>
                </div>
                <h1 class="input-group-text">Weights
                    <span class="tooltiptext">Below you can define what you would like to train, the weights have to add up to 1.0</span>
                </h1>
                <div class="input-group mb-3">
                    <span class="input-group-text">Weight power
                        <span class="tooltiptext">How much should the class be focused on training power?</span>
                    </span>
                    <input type="number" class="form-control" id="input-weight-power" value="0.5" min="0" max="1"
                           step="0.01" name="weightPower"/>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Weight fingers
                        <span class="tooltiptext">How much should the class be focused on finger strength?</span>
                    </span>
                    <input type="number" class="form-control" id="input-weight-fingers" value="0.3" min="0" max="1"
                           step="0.01" name="weightFingers"/>
                </div>
                <div class="input-group mb-3">
                    <span class="input-group-text">Weight footholds
                        <span class="tooltiptext">How much should the class be focused on foot positioning?</span>
                    </span>
                    <input type="number" class="form-control" id="input-weight-footholds" value="0.2" min="0" max="1"
                           step="0.01" name="weightFootholds"/>
                </div>

                <div class="input-group mb-1 d-grid gap-2">
                    <button id="button-login" type="button" class="btn btn-secondary">
                    </button>
                </div>
                <div class="form-text mb-3" id="div-login-text">
                </div>
                <div id="div-sets" class="d-none"></div>
                <div id="div-sets-inputs"></div>
                <div class="input-group mb-3">
                    <div class="col d-grid me-1">
                        <button class="btn btn-success" type="submit" formaction="/create">Set climbs</button>
                    </div>
                    <div class="col d-grid ms-1">
                        <button class="btn btn-primary" type="submit" id="button-next" disabled>
                            Find climbs
                        </button>
                    </div>
                    <div class="col d-grid me-1">
                        <button class="btn btn-success" type="submit" formaction="/generate">Generate climbs</button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="row justify-content-md-center mt-3">
        {% include 'footer.html.j2' %}
    </div>
</div>
<!-- Modal -->
<div class="modal fade" id="div-modal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="header-modal-title"></h1>
                <button type="button" id="button-close" class="btn-close"></button>
            </div>
            <form id="form-login">
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="input-username" class="form-label" id="label-username"></label>
                        <input type="text" class="form-control" id="input-username" autocomplete="on" minlength="1"
                               required>
                    </div>
                    <div class="mb-3">
                        <label for="input-password" class="form-label" id="label-password"></label>
                        <input type="password" class="form-control" id="input-password" autocomplete="on" minlength="1"
                               required>
                    </div>
                </div>
                <div class="modal-footer">
                    <div class="input-group d-grid gap-2">
                        <button type="submit" class="btn btn-primary">Login</button>
                    </div>
                    <div class="input-group">
                        <p class="text-end text-danger" id="paragraph-login-error"></p>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-C6RzsynM9kWDrMNeT87bh95OGNyZPhcTNXj1NW7RuBCsyN/o0jlpcV8Qyq46cDfL"
        crossorigin="anonymous"></script>
<script src="{{ url_for('static', filename='js/boardSelection.js') }}"></script>
</body>

</html>